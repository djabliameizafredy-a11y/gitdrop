{
  "name": "gitdrop",
  "version": "1.0.0",
  "description": "Drop your project. Push to GitHub. Crée un dépôt GitHub et y pousse un dossier ou un .zip en quelques secondes (CLI + interface locale).",
  "keywords": [
    "github",
    "git",
    "push",
    "cli",
    "upload",
    "repository",
    "zip"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "gitdrop": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/ui",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:ui",
    "build:cli": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:binary": "node scripts/build-binary.mjs",
    "dev:cli": "tsx src/cli.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "node --import tsx --test test/unit.test.mjs test/e2e.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "adm-zip": "^0.5.16",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.6"
  }
}
